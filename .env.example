# POST target. Copy this file into the plugin config directory, not the checkout.
WEBHOOK_URL=

# Sent as: Authorization: Bearer <WEBHOOK_KEY>
WEBHOOK_KEY=

# Optional extra header that also receives the raw key.
# Grok Bot webhook routines need:
# WEBHOOK_KEY_HEADER=X-Automation-Key
WEBHOOK_KEY_HEADER=

# Comma-separated statuses. Allowed: idle, working, blocked, done, unknown.
NOTIFY_STATUSES=done,blocked

# Comma-separated case-insensitive globs against the pane name.
# Example: SKIP_PANES=monitor,logs-*,*-watch
SKIP_PANES=

# 1 = print JSON to stdout and skip the POST.
WEBHOOK_DRY_RUN=0

# Milliseconds spanning live-status samples before a done/blocked POST
# or before idle/unknown clears posted. Default 10000. Three samples
# across this window; one flip aborts. 0 skips the wait (fast tests).
SETTLE_MS=10000
